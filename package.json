{
  "name": "axle",
  "version": "0.1.0",
  "private": true,
  "description": "Axle: a harness-first code editor. Call-flow canvas, terminal agents with live status, and tools for Claude Code harness engineering.",
  "license": "MIT",
  "repository": "https://github.com/bothuany/axle",
  "engines": {
    "node": ">=24.18 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "web": "node scripts/start.mjs --web",
    "shortcut": "node scripts/install-shortcut.mjs",
    "installer": "node scripts/installer.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build:canvas": "npm --prefix ui run build"
  }
}
