+.monaco-workbench.modern-ui .part.titlebar .agent-status-pill:hover {
+	border-color: var(--flow-glow);
+	box-shadow: 0 0 0 3px color-mix(in srgb, var(--flow-signal) 10%, transparent);
+}
+
+/* ---- Chat as a flow: one reading column, however wide the panel ----------------------------------
+ * Open the panel wide (or maximise it) and the conversation stays a column; the prompt card sits
+ * under it at the same width. Replies are set larger, with more air between turns. */
+.monaco-workbench.modern-ui .interactive-session .interactive-list .interactive-item-container {
+	max-width: 780px;
+	margin-inline: auto;
+	padding-block: 16px 8px;
+	box-sizing: border-box;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-input-part {
+	width: min(820px, calc(100% - 24px));
+	margin-inline: auto;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-response .rendered-markdown {
+	font-size: 13.5px;
+}
+.monaco-workbench.modern-ui .interactive-session .chat-welcome-view-container {
+	max-width: 780px;
+	margin-inline: auto;
+}
+
+/* ==== Chat, rebuilt: quiet, plain, one composer ====================================================
+ * Nothing on screen but the conversation and the box you type in. The reply is plain text; what the
+ * agent did is a muted line you can open; the prompt is a card; the send button is a white disc. */
+
+/* Empty chat: no logo, no disclaimer. */
+.monaco-workbench.modern-ui .interactive-session .chat-welcome-view > :is(.chat-welcome-view-icon, .chat-welcome-view-title, .chat-welcome-view-message, .chat-welcome-view-disclaimer, .chat-welcome-view-tips) {
