+}
+
+/* Changes the agent made: a card that sits on top of the box. */
+.monaco-workbench.modern-ui .interactive-session .chat-editing-session {
+	margin-inline: 8px;
+}
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench.modern-ui .interactive-session .chat-input-container,
+	.monaco-workbench.modern-ui .interactive-session .chat-secondary-toolbar { transition: none; }
+}
