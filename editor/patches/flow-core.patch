+}
+.monaco-workbench.modern-ui .part.sidebar .composite-bar .action-item.checked .action-label {
+	color: var(--vscode-activityBar-foreground) !important;
+}
+
+/* The title bar is one line: the command pill, wide and tall, is the only thing in it. */
+.monaco-workbench.modern-ui .part.titlebar .agent-status-pill {
+	min-width: min(620px, 46vw);
+	height: 28px;
+	border-radius: 999px;
+	background: color-mix(in srgb, var(--vscode-commandCenter-background) 80%, transparent);
