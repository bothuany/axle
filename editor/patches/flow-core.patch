+	background: transparent;
+}
+.monaco-workbench.modern-ui .interactive-session .chat-input-toolbars .monaco-action-bar .action-item:not(.chat-submit-button) .action-label:hover {
+	background: color-mix(in srgb, var(--vscode-foreground) 9%, transparent);
