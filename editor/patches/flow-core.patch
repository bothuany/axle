+/* The panel header carries the dock and the actions; its title only repeats them. */
+.monaco-workbench.modern-ui .part.auxiliarybar > .composite.title > .title-label,
+.monaco-workbench.modern-ui .part.auxiliarybar .title-label h2 {
+	display: none;
+}
+
+/* Your prompt: a card. */
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-request > .value > .chat-markdown-part.rendered-markdown {
+	padding: 9px 12px;
