+	box-shadow: 0 0 8px var(--flow-glow);
+}
+
+/* The dock: the open place carries the wire on the rail's inner edge. */
+.monaco-workbench.modern-ui .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked .active-item-indicator {
+	background-color: color-mix(in srgb, var(--flow-signal) 14%, transparent) !important;
