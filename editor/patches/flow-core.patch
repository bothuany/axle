+	font-feature-settings: 'cv11', 'ss01';
+}
+.monaco-workbench.modern-ui .part.sidebar > .title > .title-label h2,
+.monaco-workbench.modern-ui .part.auxiliarybar > .title > .title-label h2,
+.monaco-workbench.modern-ui .pane-header .title,
+.monaco-workbench.modern-ui .part.panel > .title .panel-switcher-container .action-label,
+.monaco-workbench.modern-ui .part.editor .tabs-container .tab .tab-label,
+.monaco-workbench.modern-ui .part.statusbar .statusbar-item-label,
+.monaco-workbench.modern-ui .part.titlebar .command-center .action-item.command-center-center .search-label {
+	font-family: var(--flow-label);
+}
+.monaco-workbench.modern-ui .part.sidebar > .title > .title-label h2,
+.monaco-workbench.modern-ui .part.auxiliarybar > .title > .title-label h2 {
+	font-size: 12.5px;
+	font-weight: 600;
+}
+.monaco-workbench.modern-ui .part.editor .tabs-container .tab .tab-label {
+	font-size: 12.5px;
+}
+.monaco-workbench.modern-ui .part.statusbar .statusbar-item-label {
+	font-size: 12px;
+}
+
+/* ---- The wire: where you are, in signal ---------------------------------------------------------- */
+.monaco-workbench.modern-ui .monaco-list .monaco-list-row.selected::before,
+.monaco-workbench.modern-ui .monaco-list .monaco-list-row.focused.selected::before {
+	content: '';
+	position: absolute;
+	left: 1px;
+	top: 5px;
+	bottom: 5px;
+	width: 2px;
+	border-radius: 2px;
