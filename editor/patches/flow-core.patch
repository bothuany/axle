+}
+.monaco-workbench.modern-ui .interactive-session .chat-input-container .interactive-input-editor .monaco-editor {
+	font-size: 13.5px;
+}
+
+.monaco-workbench.modern-ui .interactive-session .chat-input-container :is(.chat-editor-container, .interactive-input-editor) :is(.monaco-editor, .monaco-editor-background, .margin, .monaco-editor .inputarea) {
