+}
+
+/* ---- Buttons: signal fill, no outline ----------------------------------------------------------------- */
+.monaco-workbench.modern-ui .monaco-button:not(.secondary):not(.disabled) {
+	box-shadow: 0 1px 0 rgb(255 255 255 / .18) inset, 0 6px 14px -8px var(--flow-glow);
+}
+
+/* ---- Title bar: the pill says where you are; keep it centred and quiet -------------------------------- */
+.monaco-workbench.modern-ui .part.titlebar .command-center .action-item.command-center-center {
+	background: color-mix(in srgb, var(--vscode-commandCenter-background) 80%, transparent) !important;
+}
+.monaco-workbench.modern-ui .part.titlebar .command-center .action-item.command-center-center:hover {
+	border-color: var(--flow-glow) !important;
+	box-shadow: 0 0 0 3px color-mix(in srgb, var(--flow-signal) 10%, transparent);
+}
+
+/* ---- Scrollbars: slim, only on hover ------------------------------------------------------------------- */
+.monaco-workbench.modern-ui .monaco-scrollable-element > .scrollbar > .slider {
+	border-radius: 6px;
+}
+
+/* ---- Status bar: the left edge speaks; numbers set in the label face ---------------------------------- */
+.monaco-workbench.modern-ui .part.statusbar .statusbar-item.has-background-color,
+.monaco-workbench.modern-ui .part.statusbar .statusbar-item.remote-kind {
+	border-radius: 6px;
+}
+
+/* ==== Layout pass: top dock, one title line ======================================================
+ * The dock lives in the side bar's header (workbench.activityBar.location: top). The open place is
+ * marked by the wire under its icon, the same line as under the open tab. */
+.monaco-workbench.modern-ui .part.sidebar .composite-bar .action-item {
+	position: relative;
+}
+.monaco-workbench.modern-ui .part.sidebar .composite-bar .action-item.checked::before {
+	content: '' !important;
+	position: absolute !important;
+	left: 7px !important;
