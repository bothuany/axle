+}
+.monaco-workbench.modern-ui .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked::before {
+	content: '';
+	position: absolute;
+	left: -4px;
+	top: 9px;
+	bottom: 9px;
+	width: 3px;
+	border-radius: 0 3px 3px 0;
+	background: var(--flow-signal);
+	box-shadow: 0 0 10px var(--flow-glow);
+}
+.monaco-workbench.modern-ui .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked .action-label.codicon {
+	color: var(--vscode-activityBar-foreground) !important;
