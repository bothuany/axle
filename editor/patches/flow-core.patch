diff --git a/src/vs/workbench/browser/media/flow.css b/src/vs/workbench/browser/media/flow.css
new file mode 100644
index 00000000..e1c873a8
--- /dev/null
+++ b/src/vs/workbench/browser/media/flow.css
@@ -0,0 +1,226 @@
+/*---------------------------------------------------------------------------------------------
+ *  Flow: workbench touches on top of the Modern UI. Colours live in the Flow Dark theme; this
+ *  file only holds what a theme cannot express.
+ *--------------------------------------------------------------------------------------------*/
+
+/* The empty editor shows Flow's mark: an entry point, then a method frame holding what it calls. */
+.monaco-workbench .part.editor > .content .editor-group-container .editor-group-watermark .letterpress {
+	background-image: url('./flow-mark.svg') !important;
+	background-size: contain;
+	aspect-ratio: 2 / 1 !important;
+}
+
+/* The Flow trail (flow-view): each step is a glyph item and a label item; pull them into one unit. */
+.monaco-workbench .part.statusbar .statusbar-item[id*="flow.trail."] > .statusbar-item-label {
+	padding: 0 3px;
+}
+.monaco-workbench .part.statusbar .statusbar-item[id*="flow.trail."] {
+	margin: 0 -1px;
+}
+
+/* ---- Chat: a prompt card, then the agent's work along one wire ----------------------------------
+ * The prompt reads as a note handed to the agent: a full-width card, left aligned. The reply drops
+ * the avatar header and runs along a thin rail, the same wire that joins cards on the Flow canvas;
+ * every tool step is a node on it, lit while it runs. */
+
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-request {
+	align-items: stretch;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-item-container.interactive-request > .value {
+	align-items: stretch !important;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-request > .value > .chat-markdown-part.rendered-markdown {
+	max-width: none;
+	width: 100%;
+	box-sizing: border-box;
+	margin-left: 0;
+	padding: 10px 12px;
+	border: 1px solid var(--vscode-chat-requestBorder);
+	border-radius: 10px;
+	background-color: var(--vscode-chat-requestBubbleBackground);
+	color: var(--vscode-foreground);
+	line-height: 1.5;
+}
+
+/* The reply speaks for itself: no avatar row. The agent's name is on the session and its chip. */
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-response > .header {
+	display: none;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-response > .value {
+	position: relative;
+	padding-left: 20px;
+	line-height: 1.6;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container.interactive-response > .value::before {
+	content: '';
+	position: absolute;
+	left: 6px;
+	top: 2px;
+	bottom: 6px;
+	width: 1px;
+	background: var(--vscode-chat-requestBorder);
+}
+
+/* Steps on the wire: a hollow node when done, a lit one while it runs. */
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > .chat-tool-invocation-part,
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > .chat-used-context {
+	position: relative;
+	color: var(--vscode-descriptionForeground);
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > .chat-tool-invocation-part::before,
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > .chat-used-context::before {
+	content: '';
+	position: absolute;
+	left: -17px;
+	top: 7px;
+	width: 7px;
+	height: 7px;
+	border-radius: 50%;
+	box-sizing: border-box;
+	border: 1.5px solid var(--vscode-descriptionForeground);
+	background: var(--vscode-sideBar-background);
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > .chat-tool-invocation-part:has(.codicon-loading)::before {
+	border-color: var(--vscode-progressBar-background);
+	background: var(--vscode-progressBar-background);
+	box-shadow: 0 0 0 3px color-mix(in srgb, var(--vscode-progressBar-background) 25%, transparent);
+}
+
+/* Code in replies sits a step darker than the panel, like the editor it came from. */
+.monaco-workbench.modern-ui .interactive-session .interactive-result-code-block {
+	border: 1px solid var(--vscode-chat-requestBorder);
+	border-radius: 8px;
+	overflow: hidden;
+}
+.monaco-workbench.modern-ui .interactive-session .interactive-item-container .value .rendered-markdown p > code {
+	padding: 1px 5px;
+	border-radius: 4px;
+	font-size: 0.92em;
+}
+
+/* Copy and timing only when you look for them; the latest reply keeps them. */
+.monaco-workbench.modern-ui .interactive-session .interactive-response:not(.chat-most-recent-response):not(:hover) > .chat-footer-toolbar {
+	opacity: 0;
+}
+
+/* The input: a raised card that lights up in the signal colour while you type. */
+.monaco-workbench.modern-ui .interactive-session .chat-input-container {
+	--chat-input-radius: 12px;
+	background-color: var(--vscode-chat-requestBubbleBackground);
+	border-color: var(--vscode-chat-requestBorder);
+	transition: border-color .12s, box-shadow .12s;
+}
+.monaco-workbench.modern-ui .interactive-session .chat-input-container.focused {
+	border-color: color-mix(in srgb, var(--vscode-progressBar-background) 60%, transparent);
+	box-shadow: 0 0 0 3px color-mix(in srgb, var(--vscode-progressBar-background) 12%, transparent);
+}
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench.modern-ui .interactive-session .chat-input-container { transition: none; }
+}
+
+/* ---- Dock: the activity bar as a column of tiles, each place in its own colour ------------------
+ * VS Code's bar is grey glyphs with a white stripe. Here every place keeps a hue (files blue, search
+ * amber, changes green, run coral, harness teal, flow violet): dimmed at rest, full on its tile when open. */
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-explorer-view-icon) { --dock: #7aa2f7; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-search-view-icon) { --dock: #e5b567; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-source-control-view-icon) { --dock: #6fcf97; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-run-view-icon) { --dock: #f2777a; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-extensions-view-icon) { --dock: #9aa4bf; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has([class*='view-extension-flowHarness']) { --dock: #4fd1c5; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has([class*='view-extension-flow-']) { --dock: #b392f0; }
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:has(.codicon-test-view-icon) { --dock: #e0af68; }
+
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item[style] .action-label.codicon,
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item .action-label.codicon {
+	color: color-mix(in srgb, var(--dock, var(--vscode-activityBar-inactiveForeground)) 62%, var(--vscode-activityBar-background)) !important;
+}
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item .action-label.uri-icon {
+	background-color: color-mix(in srgb, var(--dock, var(--vscode-activityBar-inactiveForeground)) 62%, var(--vscode-activityBar-background)) !important;
+}
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:is(.checked, :hover) .action-label.codicon {
+	color: var(--dock, var(--vscode-activityBar-foreground)) !important;
+}
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item:is(.checked, :hover) .action-label.uri-icon {
+	background-color: var(--dock, var(--vscode-activityBar-foreground)) !important;
+}
+.monaco-workbench.modern-ui .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item.checked .active-item-indicator {
+	background-color: color-mix(in srgb, var(--dock, #7aa2f7) 16%, transparent) !important;
+	border-radius: 10px;
+	box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--dock, #7aa2f7) 28%, transparent);
+}
+.monaco-workbench.modern-ui .activitybar > .content:not(.dragged-over) :not(.monaco-menu) > .monaco-action-bar .action-item:not(.checked):hover .active-item-indicator {
+	background-color: color-mix(in srgb, var(--dock, #7aa2f7) 9%, transparent) !important;
+	border-radius: 10px;
+}
+/* Badges take the colour of their place instead of one blue for everything. */
+.monaco-workbench .activitybar > .content :not(.monaco-menu) > .monaco-action-bar .action-item .badge .badge-content {
+	background-color: var(--dock, var(--vscode-activityBarBadge-background)) !important;
+	color: #17181d !important;
+	font-weight: 700;
+}
+
+/* The app menu at the top of the dock wears the Flow mark. */
+.monaco-workbench .activitybar .menubar .toolbar-toggle-more::before,
+.monaco-workbench .activitybar .menubar .menubar-menu-title .codicon-menu::before {
+	content: '' !important;
+}
+.monaco-workbench .activitybar .menubar .toolbar-toggle-more,
+.monaco-workbench .activitybar .menubar .menubar-menu-title .codicon-menu {
+	background: linear-gradient(135deg, #7aa2f7, #b392f0) !important;
+	-webkit-mask: url('./flow-mark.svg') center / 22px no-repeat;
+	mask: url('./flow-mark.svg') center / 22px no-repeat;
+	-webkit-mask-size: 24px;
+}
+
+/* ---- Title bar: one command pill in the middle, nothing else asking for attention ------------- */
+.monaco-workbench .part.titlebar .command-center .agent-status-command-center-toolbar,
+.monaco-workbench .part.titlebar .command-center-center {
+	min-width: min(460px, 40vw) !important;
+}
+.monaco-workbench .part.titlebar .command-center .action-item.command-center-center {
+	border-radius: 999px !important;
+	background: var(--vscode-commandCenter-background) !important;
+	border: 1px solid var(--vscode-commandCenter-border) !important;
+	height: 24px;
+}
+.monaco-workbench .part.titlebar .command-center .action-item.command-center-center:hover {
+	border-color: color-mix(in srgb, #7aa2f7 45%, transparent) !important;
+}
+
+/* ---- Side bar: quiet headers, sentence case, a little more air ---------------------------------- */
+.monaco-workbench .part.sidebar > .title > .title-label h2,
+.monaco-workbench .part.auxiliarybar > .title > .title-label h2 {
+	text-transform: none;
+	font-size: 12.5px;
+	font-weight: 600;
+	letter-spacing: 0;
+	color: var(--vscode-foreground);
+}
+.monaco-workbench .pane-header .title {
+	text-transform: none !important;
+	font-weight: 600 !important;
+	font-size: 11.5px !important;
+	letter-spacing: 0 !important;
+}
+.monaco-workbench .monaco-list .monaco-list-row {
+	border-radius: 6px;
+}
+
+/* ---- Pop-ups: rounder, lifted, a soft edge -------------------------------------------------------- */
+.monaco-workbench .quick-input-widget {
+	border-radius: 14px !important;
+	box-shadow: 0 0 0 1px var(--vscode-widget-border), 0 24px 60px -12px rgb(0 0 0 / .65) !important;
+	overflow: hidden;
+}
+.monaco-workbench .notifications-toasts .notification-toast-container > .notification-toast,
+.monaco-workbench .notifications-center {
+	border-radius: 12px !important;
+}
+.monaco-workbench .monaco-menu .monaco-action-bar.vertical {
+	border-radius: 10px;
+}
+
+/* ---- Status bar: no band of colour, items as soft chips ----------------------------------------- */
+.monaco-workbench .part.statusbar > .items-container > .statusbar-item > .statusbar-item-label {
+	border-radius: 6px;
+}
