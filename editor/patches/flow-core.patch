+
+/* What the agent did: muted one-liners that brighten on hover. */
+.monaco-workbench.modern-ui .interactive-session .interactive-response > .value > :is(.chat-tool-invocation-part, .chat-used-context, .chat-thinking-box, .chat-collapsible-list) {
