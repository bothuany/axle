+}
+.monaco-workbench.modern-ui .part.editor .tabs-container .tab.dirty .tab-actions .codicon {
+	color: var(--flow-signal);
+}
+
+/* Anything in progress runs on the wire. */
+.monaco-workbench.modern-ui .monaco-progress-container .progress-bit {
+	background-color: var(--flow-signal);
+	box-shadow: 0 0 10px var(--flow-glow);
+}
+
+/* Focus is a glow, not a box. */
+.monaco-workbench.modern-ui .monaco-inputbox.synthetic-focus,
+.monaco-workbench.modern-ui .monaco-findInput.synthetic-focus {
