+}
+
+/* The row under the text: ghost buttons, no outlines. */
+.monaco-workbench.modern-ui .interactive-session .chat-input-container .chat-input-toolbars {
+	align-items: center;
+	gap: 4px;
+	padding: 0;
+}
+.monaco-workbench.modern-ui .interactive-session .chat-input-toolbars .monaco-action-bar .action-item .action-label,
+.monaco-workbench.modern-ui .interactive-session .chat-input-toolbars .chat-input-picker-item .action-label {
+	height: 24px;
+	padding: 0 8px;
+	border: 0;
+	border-radius: 7px;
