+const PAGE = /* html */ `<!doctype html><html><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
+<title>Axle Agents</title>
+<style>
+html, body { margin: 0; background: transparent; overflow: hidden; cursor: default; -webkit-user-select: none; user-select: none; }
+body { font: 12px/1.3 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0.005em; color: var(--foreground); }
+body.size-small { font-size: 11px; }
+body.size-large { font-size: 14px; }
+#root { position: absolute; top: 0; left: 0; width: max-content; padding: 6px 8px 10px; }
+body.attached #root { padding-top: 0; }
+.box { display: flex; align-items: center; gap: 0.85em; padding: 0.55em 1.1em; background: var(--background); color: var(--foreground); border: 1px solid var(--border); border-radius: 999px; animation: in 140ms ease-out; }
+body.attached .box { border-top-color: transparent; border-radius: 0 0 1.5em 1.5em; }
+.box.list { flex-direction: column; align-items: stretch; gap: 0.1em; padding: 0.7em 0.5em 0.5em; border-radius: 1.2em; min-width: 21em; }
+body.attached .box.list { border-radius: 0 0 1.5em 1.5em; }
+@keyframes in { from { opacity: 0.4; } }
+@media (prefers-reduced-motion: reduce) { .box { animation: none; } }
+.sep { width: 1px; align-self: stretch; margin: 0.15em 0; background: var(--border); }
+.lead { display: flex; align-items: baseline; gap: 0.55em; min-width: 0; }
+.name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 12em; }
+.verb { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 12em; }
+.more { color: var(--muted); }
+.meta { display: flex; align-items: center; gap: 0.6em; margin-left: auto; color: var(--muted); white-space: nowrap; }
+.head { display: flex; gap: 0.9em; padding: 0.1em 0.8em 0.55em; color: var(--muted); font-size: 0.82em; letter-spacing: 0.08em; text-transform: uppercase; }
+.head b { color: var(--foreground); font-weight: 600; }
+.row { display: flex; align-items: center; gap: 0.7em; padding: 0.5em 0.8em; border-radius: 0.8em; cursor: pointer; }
+.row:hover { background: color-mix(in srgb, var(--foreground) 9%, transparent); }
+.row .verb { flex: 1; }
+.row.empty { cursor: default; color: var(--muted); }
+${AVATAR_CSS}
+.dots { display: flex; gap: 0.45em; align-items: center; }
