+import { ACTIVITY_BAR_BADGE_BACKGROUND, ACTIVITY_BAR_BADGE_FOREGROUND } from '../../../common/theme.js';
+
+registerMainProcessRemoteService(IAxleOverlayService, AXLE_OVERLAY_CHANNEL);
+
+/** flow-agent registers this: it shows a live agent's terminal and ignores an id it does not know. */
+const REVEAL_AGENT = 'flow.agents.reveal';
+
+class AxleDesktopContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.axleDesktop';
+
+	/** Windows renders the taskbar overlay small, so draw at 2x for HiDPI. */
