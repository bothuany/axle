--- /dev/null
+++ b/src/vs/workbench/contrib/axleDesktop/electron-browser/axleDesktop.contribution.ts
@@ -0,0 +1,167 @@
+/*---------------------------------------------------------------------------------------------
+ *  Axle: agent status outside the window, for Axle's Agents extension (flow-agent, src/desktop.ts).
+ *
+ *  - `flow.desktop.setBadge(count)`: the number of agents that need you on the app icon (Dock on
+ *    macOS, taskbar overlay icon on Windows, launcher on Linux), through the same native call as
+ *    the Sessions badge. 0 clears it.
+ *  - `flow.desktop.setOverlay(state | undefined)`: this window's agents for the status overlay the
+ *    main process draws (platform/axleDesktop), with the colours of this window's theme.
+ *
+ *  Both commands exist only in the desktop app, so the extension finds them missing in the browser
+ *  and does nothing. A click on an agent in the overlay is the user's gesture: the agent's terminal
+ *  is shown and this window comes forward. That is the one place where the overlay leads to focus.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { Color } from '../../../../base/common/color.js';
+import { Disposable, toDisposable } from '../../../../base/common/lifecycle.js';
+import { isWindows } from '../../../../base/common/platform.js';
+import { localize } from '../../../../nls.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { registerMainProcessRemoteService } from '../../../../platform/ipc/electron-browser/services.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { FocusMode, IApplicationBadge, INativeHostService } from '../../../../platform/native/common/native.js';
+import { IColorTheme, IThemeService } from '../../../../platform/theme/common/themeService.js';
+import { AXLE_OVERLAY_CHANNEL, IAxleOverlayColors, IAxleOverlayService, IAxleOverlayState } from '../../../../platform/axleDesktop/common/axleDesktop.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { ACTIVITY_BAR_BADGE_BACKGROUND, ACTIVITY_BAR_BADGE_FOREGROUND } from '../../../common/theme.js';
+
+registerMainProcessRemoteService(IAxleOverlayService, AXLE_OVERLAY_CHANNEL);
+
+/** flow-agent registers this: it shows a live agent's terminal and ignores an id it does not know. */
+const REVEAL_AGENT = 'flow.agents.reveal';
+
+class AxleDesktopContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.axleDesktop';
+
+	/** Windows renders the taskbar overlay small, so draw at 2x for HiDPI. */
+	private static readonly ICON_SIZE = 32;
+	/** Beyond this the label no longer fits into a 16x16 overlay. */
+	private static readonly MAX_ICON_COUNT = 9;
+
+	private badgeCount = 0;
+	private overlay: IAxleOverlayState | undefined;
+
+	constructor(
+		@INativeHostService private readonly nativeHostService: INativeHostService,
+		@IThemeService private readonly themeService: IThemeService,
+		@IAxleOverlayService private readonly overlayService: IAxleOverlayService,
+		@ICommandService commandService: ICommandService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+
+		this._register(CommandsRegistry.registerCommand('flow.desktop.setBadge', (_accessor, count: unknown) => {
+			this.setBadge(typeof count === 'number' && Number.isFinite(count) ? Math.max(0, Math.floor(count)) : 0);
+		}));
+		this._register(CommandsRegistry.registerCommand('flow.desktop.setOverlay', (_accessor, state: unknown) => {
+			this.overlay = state && typeof state === 'object' ? state as IAxleOverlayState : undefined;
+			this.pushOverlay();
+		}));
+
+		this._register(this.themeService.onDidColorThemeChange(theme => {
+			// The Windows overlay icon and the overlay's colours are drawn from the theme.
+			if (this.badgeCount && isWindows) {
+				this.sendBadge(this.badgeCount, theme);
+			}
+			if (this.overlay) {
+				this.pushOverlay();
+			}
+		}));
+
+		this._register(this.overlayService.onDidClickAgent(e => {
+			if (e.windowId !== this.nativeHostService.windowId) {
+				return;
+			}
+			commandService.executeCommand(REVEAL_AGENT, e.id).catch(err => this.logService.warn(`[axle desktop] ${REVEAL_AGENT} failed: ${err}`));
+			this.nativeHostService.focusWindow({ mode: FocusMode.Force });
+		}));
+
+		// The badge is application wide on macOS and Linux and the overlay outlives this window: clear both with it.
+		this._register(toDisposable(() => {
+			this.setBadge(0);
+			if (this.overlay) {
+				this.overlay = undefined;
+				this.pushOverlay();
+			}
+		}));
+	}
+
+	private setBadge(count: number): void {
+		if (count === this.badgeCount) {
+			return;
+		}
+		this.badgeCount = count;
+		this.sendBadge(count, isWindows ? this.themeService.getColorTheme() : undefined);
+	}
+
+	private sendBadge(count: number, colorTheme: IColorTheme | undefined): void {
+		let badge: IApplicationBadge | undefined;
+		if (count > 0) {
+			const description = count === 1
+				? localize('axle.desktop.badge.single', "1 agent needs you")
+				: localize('axle.desktop.badge.multiple', "{0} agents need you", count);
+			// Leave `iconDataURL` out rather than undefined: the IPC drops undefined properties (see SessionsApplicationBadge).
+			const iconDataURL = colorTheme ? this.renderIcon(count, colorTheme) : undefined;
+			badge = iconDataURL ? { count, description, iconDataURL } : { count, description };
+		}
+		this.nativeHostService.setApplicationBadge(badge).catch(err => this.logService.warn(`[axle desktop] badge failed: ${err}`));
+	}
+
+	/** The taskbar overlay icon on Windows: a badge-coloured disc with the count, drawn like the Sessions badge. */
+	private renderIcon(count: number, colorTheme: IColorTheme): string | undefined {
+		const size = AxleDesktopContribution.ICON_SIZE;
+		const canvas = mainWindow.document.createElement('canvas');
+		canvas.width = size;
+		canvas.height = size;
+		const context = canvas.getContext('2d');
+		if (!context) {
+			return undefined;
+		}
+		context.fillStyle = (colorTheme.getColor(ACTIVITY_BAR_BADGE_BACKGROUND) ?? Color.blue).toString();
+		context.beginPath();
+		context.arc(size / 2, size / 2, size / 2, 0, 2 * Math.PI);
+		context.fill();
+		const label = count > AxleDesktopContribution.MAX_ICON_COUNT ? `${AxleDesktopContribution.MAX_ICON_COUNT}+` : String(count);
+		context.fillStyle = (colorTheme.getColor(ACTIVITY_BAR_BADGE_FOREGROUND) ?? Color.white).toString();
+		context.font = `600 ${label.length > 1 ? 17 : 21}px "Segoe UI", sans-serif`;
+		context.textAlign = 'center';
+		context.textBaseline = 'middle';
+		context.fillText(label, size / 2, size / 2 + 1);
+		return canvas.toDataURL('image/png');
+	}
+
+	private pushOverlay(): void {
+		const colors = this.overlay ? this.overlayColors(this.themeService.getColorTheme()) : undefined;
+		this.overlayService.update(this.nativeHostService.windowId, this.overlay, colors).catch(err => this.logService.warn(`[axle desktop] overlay failed: ${err}`));
+	}
+
+	/** The overlay in this theme's colours: a widget's background and text, the chart colours for the states. */
+	private overlayColors(theme: IColorTheme): IAxleOverlayColors {
+		const pick = (fallback: string, ...ids: string[]) => {
+			for (const id of ids) {
+				const c = theme.getColor(id);
+				if (c) {
+					return c.toString();
+				}
+			}
+			return fallback;
+		};
+		const dark = theme.type !== 'light' && theme.type !== 'hcLight';
+		return {
+			background: pick(dark ? '#1c1d23' : '#fafafc', 'editorWidget.background', 'editor.background'),
+			foreground: pick(dark ? '#e8e9ee' : '#1f2128', 'editorWidget.foreground', 'foreground'),
+			muted: pick(dark ? '#a3a7b5' : '#5d6170', 'descriptionForeground'),
+			border: pick(dark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.12)', 'editorWidget.border', 'widget.border', 'contrastBorder'),
+			working: pick('#6f86ff', 'charts.blue'),
+			approval: pick('#ffb454', 'charts.yellow', 'editorWarning.foreground'),
+			question: pick('#c58cff', 'charts.purple'),
+			error: pick('#ff6b6b', 'charts.red', 'errorForeground'),
+			done: pick('#5fe0a1', 'charts.green'),
+			idle: pick('#7d8293', 'disabledForeground', 'descriptionForeground'),
+		};
+	}
+}
+
+registerWorkbenchContribution2(AxleDesktopContribution.ID, AxleDesktopContribution, WorkbenchPhase.BlockRestore);
