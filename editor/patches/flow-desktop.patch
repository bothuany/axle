+function report() {
+	const r = root.getBoundingClientRect();
+	const size = { type: 'size', width: Math.ceil(r.width), height: Math.ceil(r.height) };
+	const key = size.width + 'x' + size.height;
+	if (key !== reported) {
+		reported = key;
+		say(size);
+	}
+}
+setInterval(() => {
+	document.querySelectorAll('[data-since]').forEach(e => { e.textContent = elapsed(Number(e.dataset.since)); });
+	report();
+}, 1000);
+root.addEventListener('mouseenter', () => { if (!hover) { hover = true; render(); } });
+root.addEventListener('mouseleave', () => { if (hover) { hover = false; render(); } });
+window.axleRender = model => { data = model; render(); };
+</script></body></html>`;
