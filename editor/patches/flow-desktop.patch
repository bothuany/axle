+			show: false,
+			focusable: false,
+			// On macOS a panel never activates the app when clicked.
+			...(isMacintosh ? { type: 'panel' } : {}),
+			frame: false,
+			transparent: true,
+			backgroundColor: '#00000000',
+			hasShadow: false,
+			resizable: false,
+			movable: false,
+			minimizable: false,
+			maximizable: false,
+			fullscreenable: false,
+			skipTaskbar: true,
+			alwaysOnTop: true,
+			width: 160,
+			height: 40,
+			title: 'Axle Agents',
+			webPreferences: {
+				sandbox: true,
+				contextIsolation: true,
+				nodeIntegration: false,
+				webSecurity: true,
