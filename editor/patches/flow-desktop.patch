+/*---------------------------------------------------------------------------------------------
+ *  Axle: agent status outside the window, for Axle's Agents extension (flow-agent, src/desktop.ts).
+ *
+ *  - `flow.desktop.setBadge(count)`: the number of agents that need you on the app icon (Dock on
+ *    macOS, taskbar overlay icon on Windows, launcher on Linux), through the same native call as
+ *    the Sessions badge. 0 clears it.
+ *  - `flow.desktop.setOverlay(state | undefined)`: this window's agents for the status overlay the
+ *    main process draws (platform/axleDesktop), with the colours of this window's theme.
+ *
+ *  Both commands exist only in the desktop app, so the extension finds them missing in the browser
+ *  and does nothing. A click on an agent in the overlay is the user's gesture: the agent's terminal
+ *  is shown and this window comes forward. That is the one place where the overlay leads to focus.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
