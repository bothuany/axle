{
  "name": "flow-theme",
  "displayName": "Axle Theme",
  "description": "Axle's look, dark and light: flat surfaces, one signal colour and the defaults that go with it.",
  "version": "0.1.0",
  "publisher": "flow",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Axle Dark",
        "label": "Axle Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/flow-dark.json"
      },
      {
        "id": "Axle Light",
        "label": "Axle Light",
        "uiTheme": "vs",
        "path": "./themes/flow-light.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Axle Dark",
      "workbench.preferredDarkColorTheme": "Axle Dark",
      "workbench.preferredLightColorTheme": "Axle Light",
      "workbench.activityBar.location": "top",
      "workbench.startupEditor": "none",
      "workbench.tree.indent": 14,
      "workbench.tree.renderIndentGuides": "none",
      "workbench.list.smoothScrolling": true,
      "workbench.layoutControl.enabled": true,
      "workbench.editor.tabActionLocation": "right",
      "window.commandCenter": true,
      "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'SF Mono', ui-monospace, Consolas, Menlo, monospace",
      "editor.fontLigatures": true,
      "editor.fontSize": 13,
      "editor.lineHeight": 21,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "all",
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.guides.bracketPairs": false,
      "editor.scrollbar.verticalScrollbarSize": 8,
      "editor.stickyScroll.enabled": true,
      "editor.padding.top": 8,
      "terminal.integrated.fontSize": 12,
      "breadcrumbs.enabled": true,
      "workbench.experimental.modernUI": true,
      "terminal.integrated.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'SF Mono', ui-monospace, Consolas, Menlo, monospace",
      "workbench.experimental.modernUIEditorTabStyle": "connected",
      "window.density.layout": "compact",
      "workbench.sideBar.location": "left",
      "workbench.editor.showIcons": true,
      "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
      "workbench.editor.wrapTabs": false,
      "workbench.editor.pinnedTabsOnSeparateRow": false,
      "workbench.editor.tabSizing": "fit",
      "window.title": "${rootName}${separator}${activeEditorShort}",
      "chat.editor.fontFamily": "default"
    }
  }
}
