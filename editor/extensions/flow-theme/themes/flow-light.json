	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#8a90a6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.control"
			],
			"settings": {
				"foreground": "#7a45e0"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.interface",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.cs",
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#0b7f99"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#2a46e6"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#1f8f55"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#c2570a"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"variable.other.readwrite"
			],
			"settings": {
				"foreground": "#262a3d"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"entity.name.variable.parameter"
			],
			"settings": {
				"foreground": "#a0560a"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"entity.name.variable.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#4a5a8a"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#d6334a"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#0b8aa3"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#5d647a"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#2a46e6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#0b8aa3"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#0b8aa3"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#d6334a"
			}
		}
	],
	"semanticTokenColors": {
		"class": "#0b7f99",
		"interface": "#0b7f99",
		"struct": "#0b7f99",
		"enum": "#0b7f99",
		"typeParameter": "#0b7f99",
		"type": "#0b7f99",
		"namespace": "#5d647a",
		"method": "#2a46e6",
		"function": "#2a46e6",
		"property": "#4a5a8a",
		"parameter": "#a0560a",
		"variable": "#262a3d",
		"enumMember": "#c2570a",
		"keyword": "#7a45e0",
		"string": "#1f8f55",
		"number": "#c2570a",
		"comment": {
			"foreground": "#8a90a6",
			"italic": true
		}
	}
}
