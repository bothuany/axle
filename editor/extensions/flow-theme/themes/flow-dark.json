	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#5f5f69",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.control"
			],
			"settings": {
				"foreground": "#c792ea"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.interface",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.cs",
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#e2c08d"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#7aa2f7"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#a8d4a0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#f78c6c"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"variable.other.readwrite"
			],
			"settings": {
				"foreground": "#c8c8cd"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"entity.name.variable.parameter"
			],
			"settings": {
				"foreground": "#e7c9a0"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"entity.name.variable.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#b4c7e8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#f07178"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#59c2a8"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#8e8e98"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#7aa2f7",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#59c2a8"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#59c2a8"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#f07178"
			}
		}
	],
	"semanticTokenColors": {
		"class": "#e2c08d",
		"interface": "#e2c08d",
		"struct": "#e2c08d",
		"enum": "#e2c08d",
		"typeParameter": "#e2c08d",
		"type": "#e2c08d",
		"namespace": "#a1a1aa",
		"method": "#7aa2f7",
		"function": "#7aa2f7",
		"property": "#b4c7e8",
		"parameter": "#e7c9a0",
		"variable": "#c8c8cd",
		"enumMember": "#f78c6c",
		"keyword": "#c792ea",
		"string": "#a8d4a0",
		"number": "#f78c6c",
		"comment": {
			"foreground": "#5f5f69",
			"italic": true
		}
	}
}
