	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6a6a6a",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.control"
			],
			"settings": {
				"foreground": "#b88cff"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.interface",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"storage.type.cs",
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#62d6e8"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#8ea6ff"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#8fe0b0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#ff9e64"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"variable.other.readwrite"
			],
			"settings": {
				"foreground": "#e0e0e0"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"entity.name.variable.parameter"
			],
			"settings": {
				"foreground": "#ffc98f"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"entity.name.variable.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#b5bcd0"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#ff6b7d"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#4fd6d0"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#8a8a8a"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#8ea6ff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#4fd6d0"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#4fd6d0"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#ff6b7d"
			}
		}
	],
	"semanticTokenColors": {
		"class": "#62d6e8",
		"interface": "#62d6e8",
		"struct": "#62d6e8",
		"enum": "#62d6e8",
		"typeParameter": "#62d6e8",
		"type": "#62d6e8",
		"namespace": "#8f8f8f",
		"method": "#8ea6ff",
		"function": "#8ea6ff",
		"property": "#b5bcd0",
		"parameter": "#ffc98f",
		"variable": "#e0e0e0",
		"enumMember": "#ff9e64",
		"keyword": "#b88cff",
		"string": "#8fe0b0",
		"number": "#ff9e64",
		"comment": {
			"foreground": "#6a6a6a",
			"italic": true
		}
	}
}
