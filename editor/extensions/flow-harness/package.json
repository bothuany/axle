{
  "name": "flow-harness",
  "displayName": "Axle Harness",
  "description": "Harness engineering in the editor: one map of instructions, rules, skills, hooks, MCP and permissions, with a health score, the context budget and X-ray, live usage, a \"why?\" view with a permission simulator, a hook studio and a friction inbox.",
  "version": "0.1.0",
  "publisher": "flow",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Hooks are only run when you ask, and only in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowHarness",
          "title": "Harness",
          "icon": "media/harness.svg"
        }
      ]
    },
    "views": {
      "flowHarness": [
        {
          "id": "flowHarness.map",
          "name": "Map",
          "icon": "media/harness.svg"
        },
        {
          "id": "flowHarness.permissions",
          "name": "Permission requests",
          "icon": "media/harness.svg"
        },
        {
          "id": "flowHarness.friction",
          "name": "Friction inbox",
          "icon": "media/harness.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "flowHarness.refresh",
        "title": "Refresh",
        "category": "Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "flowHarness.addHook",
        "title": "Add Hook…",
        "category": "Harness",
        "icon": "$(add)"
      },
      {
        "command": "flowHarness.testHook",
        "title": "Run Hook with Sample Input",
        "category": "Harness",
        "icon": "$(play)"
      },
      {
        "command": "flowHarness.promote",
        "title": "Always Allow…",
        "category": "Harness",
        "icon": "$(pass)"
      },
      {
        "command": "flowHarness.promoteDeny",
        "title": "Always Deny…",
        "category": "Harness",
        "icon": "$(circle-slash)"
      },
      {
        "command": "flowHarness.showContext",
        "title": "Show Context Budget",
        "category": "Harness"
      },
      {
        "command": "flowHarness.reportUsage",
        "title": "Report Usage",
        "category": "Harness"
      },
      {
        "command": "flowHarness.recordPermission",
        "title": "Record Permission",
        "category": "Harness"
      },
      {
        "command": "flowHarness.health",
        "title": "Harness Health",
        "category": "Harness"
      },
      {
        "command": "flowHarness.contextXray",
        "title": "Context X-ray",
        "category": "Harness",
        "icon": "$(pulse)"
      },
      {
        "command": "flowHarness.why",
        "title": "Why? Agent Configuration for This File",
        "category": "Harness",
        "icon": "$(question)"
      },
      {
        "command": "flowHarness.simulatePermission",
        "title": "Simulate a Permission",
        "category": "Harness"
      },
      {
        "command": "flowHarness.recordEvent",
        "title": "Record Agent Event",
        "category": "Harness"
      },
      {
        "command": "flowHarness.applyProposal",
        "title": "Apply…",
        "category": "Harness",
        "icon": "$(check)"
      },
      {
        "command": "flowHarness.dismissProposal",
        "title": "Dismiss",
        "category": "Harness",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flowHarness.why",
          "when": "view == flowHarness.map",
          "group": "navigation@0"
        },
        {
          "command": "flowHarness.contextXray",
          "when": "view == flowHarness.map",
          "group": "navigation@0"
        },
        {
          "command": "flowHarness.addHook",
          "when": "view == flowHarness.map",
          "group": "navigation@1"
        },
        {
          "command": "flowHarness.refresh",
          "when": "view == flowHarness.map",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "flowHarness.testHook",
          "when": "view == flowHarness.map && viewItem == hook",
          "group": "inline"
        },
        {
          "command": "flowHarness.promote",
          "when": "view == flowHarness.permissions && viewItem == request.promotable",
          "group": "inline@1"
        },
        {
          "command": "flowHarness.promoteDeny",
          "when": "view == flowHarness.permissions && viewItem == request.promotable",
          "group": "inline@2"
        },
        {
          "command": "flowHarness.applyProposal",
          "when": "view == flowHarness.friction && viewItem =~ /^friction.(proposal|grant)$/",
          "group": "inline@1"
        },
        {
          "command": "flowHarness.dismissProposal",
          "when": "view == flowHarness.friction && viewItem =~ /^friction.(proposal|grant)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "flowHarness.testHook",
          "when": "false"
        },
        {
          "command": "flowHarness.promote",
          "when": "false"
        },
        {
          "command": "flowHarness.promoteDeny",
          "when": "false"
        },
        {
          "command": "flowHarness.reportUsage",
          "when": "false"
        },
        {
          "command": "flowHarness.recordPermission",
          "when": "false"
        },
        {
          "command": "flowHarness.health",
          "when": "false"
        },
        {
          "command": "flowHarness.simulatePermission",
          "when": "false"
        },
        {
          "command": "flowHarness.recordEvent",
          "when": "false"
        },
        {
          "command": "flowHarness.applyProposal",
          "when": "false"
        },
        {
          "command": "flowHarness.dismissProposal",
          "when": "false"
        }
      ],
      "editor/title/context": [
        {
          "command": "flowHarness.why",
          "when": "resourceScheme == file",
          "group": "9_harness"
        }
      ],
      "explorer/context": [
        {
          "command": "flowHarness.why",
          "when": "resourceScheme == file",
          "group": "9_harness"
        }
      ]
    },
    "colors": [
      {
        "id": "flowHarness.instructions",
        "description": "Instructions in the harness map.",
        "defaults": {
          "dark": "#6f86ff",
          "light": "#3b6fd4"
        }
      },
      {
        "id": "flowHarness.rules",
        "description": "Rules in the harness map.",
        "defaults": {
          "dark": "#ffb454",
          "light": "#a36d00"
        }
      },
      {
        "id": "flowHarness.skills",
        "description": "Skills in the harness map.",
        "defaults": {
          "dark": "#b88cff",
          "light": "#7a4fc7"
        }
      },
      {
        "id": "flowHarness.agents",
        "description": "Subagents in the harness map.",
        "defaults": {
          "dark": "#f0a6ca",
          "light": "#b4497f"
        }
      },
      {
        "id": "flowHarness.hooks",
        "description": "Hooks in the harness map.",
        "defaults": {
          "dark": "#4fd6d0",
          "light": "#0f8a7e"
        }
      },
      {
        "id": "flowHarness.mcp",
        "description": "MCP servers in the harness map.",
        "defaults": {
          "dark": "#5fe0a1",
          "light": "#1f8a4c"
        }
      },
      {
        "id": "flowHarness.permissions",
        "description": "Permission rules in the harness map.",
        "defaults": {
          "dark": "#f2a170",
          "light": "#b85c1f"
        }
      },
      {
        "id": "flowHarness.allow",
        "description": "Allowed permissions.",
        "defaults": {
          "dark": "#5fe0a1",
          "light": "#1f8a4c"
        }
      },
      {
        "id": "flowHarness.ask",
        "description": "Permissions that ask, and a filling context window.",
        "defaults": {
          "dark": "#ffb454",
          "light": "#a36d00"
        }
      },
      {
        "id": "flowHarness.deny",
        "description": "Denied permissions, and a nearly full context window.",
        "defaults": {
          "dark": "#ff6b7d",
          "light": "#c4383c"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
