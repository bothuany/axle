#!/usr/bin/env bash
# Insilode's postinst, in place of VS Code's (which also adds Microsoft's VS Code apt repository and key).
# scripts/package.mjs replaces @@NAME@@ with product.json's applicationName.

# Symlink the command to /usr/bin
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Offer it to the alternatives system. Priority 0 never makes it the default editor in auto mode.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

# Install the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Pick up the workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

exit 0
