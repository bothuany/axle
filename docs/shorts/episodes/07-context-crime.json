				"t": 0.1,
				"tempo": 0.93,
				"text": "Monday, the agent was *brilliant*. By Friday, it forgot the one rule that mattered."
			},
			{
				"id": "n2",
				"t": 5.5,
				"tempo": 0.9,
				"text": "Somebody was eating its *context window*."
			},
