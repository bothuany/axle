				"tempo": 0.92,
				"text": "Day three at a new job. One ticket: what happens when someone places an *order*?",
				"say": "Day three at a new job. One ticket... what happens when someone places an order?"
			},
			{
				"id": "n2",
				"t": 6,
				"seed": 11,
				"text": "Easy. Ctrl-click. Ctrl-click. *Ctrl-click*.",
