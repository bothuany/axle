		"lines": [
			{
				"id": "n1",
				"t": 0.1,
				"text": "Meet Brenda. She has been waiting *47 minutes*.",
				"say": "Meet Brenda. She has been waiting forty-seven minutes."
			},
			{
				"id": "b1",
				"who": "Brenda",
				"t": 3.4,
				"tempo": 0.85,
				"text": "I didn't want to *bother* anyone."
			},
			{
				"id": "g1",
				"who": "Gary",
				"t": 5.5,
				"text": "Brenda. You are *blocking* the release."
			},
			{
				"id": "b2",
				"who": "Brenda",
				"t": 8.3,
				"tempo": 0.88,
				"text": "Ahem. Sorry. Whenever you're *free*."
			},
			{
				"id": "n2",
				"t": 11.2,
				"text": "Her developer has six terminal tabs open. Brenda is in the *fourth*.",
				"say": "Her developer has six terminal tabs open. And Brenda lives in the fourth."
			},
			{
				"id": "g2",
				"who": "Gary",
				"t": 16.1,
				"text": "Just *tell* him!"
			},
			{
				"id": "b3",
				"who": "Brenda",
				"t": 17.4,
				"tempo": 0.85,
				"text": "But he looks so *busy*."
			},
			{
				"id": "n3",
				"t": 19.4,
				"text": "So Insilode keeps every agent in one dock, and ranks who needs you *first*.",
				"say": "So In sill ode keeps every agent in one dock, and ranks who needs you first."
			},
			{
				"id": "n4",
				"t": 25,
				"text": "The approval, with its exact *text*, right on top."
			},
			{
				"id": "n5",
				"t": 29,
				"text": "Or just *look* at the island. One face per agent."
			},
			{
				"id": "n6",
				"t": 33.2,
				"text": "Open her row, and you're in her terminal. One *keypress*."
			},
			{
				"id": "b4",
				"who": "Brenda",
				"t": 38.3,
				"tempo": 0.95,
				"text": "Oh! Thank you. I have been *rehearsing* that for an hour."
			}
